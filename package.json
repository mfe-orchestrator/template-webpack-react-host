{
  "name": "webpack-react-host",
  "version": "1.0.0",
  "description": "Webpack + React + TypeScript + Module Federation Host",
  "type": "module",
  "main": "index.js",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "webpack serve --mode development --open",
